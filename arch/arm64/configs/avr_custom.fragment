# avr custom kernel: KernelSU-Next + KMI-safe power/perf tweaks
# Everything here must stay KMI-neutral so the stock vendor_dlkm/system_dlkm
# modules keep loading.

# --- root ---
CONFIG_KSU=y
# SUSFS broke Chromium on this device: Chrome pages never finished loading and
# every KernelSU WebUI rendered blank. Both work with KernelSU-Next alone.
# CONFIG_KSU_SUSFS is not set

# --- power ---
# Let WQ_POWER_EFFICIENT workqueues run unbound so the scheduler can keep
# work on already-awake CPUs instead of waking idle ones.
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y

# --- network ---
# BBR copes much better with lossy/variable cellular & Wi-Fi links than CUBIC
# (fewer retransmits, lower latency under load). Uses internal pacing; FQ is
# already built in.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
# CONFIG_TCP_CONG_BIC is not set
# CONFIG_TCP_CONG_HTCP is not set
# CONFIG_TCP_CONG_WESTWOOD is not set

# --- stock module compatibility ---
# Trust the stock GKI build's module signing cert (extracted from the stock
# boot.img), so Google-signed system_dlkm modules count as signed GKI modules
# rather than vendor modules restricted to the KMI symbol list.
CONFIG_SYSTEM_TRUSTED_KEYS="certs/avr_stock_gki_module_key.x509.pem"

# --- identity ---
# Report the stock release string in uname -r (Melt has a uname override for
# the same reason). env.sh exports LOCALVERSION= so setlocalversion appends
# nothing, plus the stock build user/host/timestamp.
CONFIG_LOCALVERSION="-android16-6-g18b507169406-ab14630870-4k"
# CONFIG_LOCALVERSION_AUTO is not set

# --- ported optimizations ---
CONFIG_BOEFFLA_WL_BLOCKER=y
# No LTO, same as stock: CONFIG_GENDWARFKSYMS (needed for stock-matching
# CRCs) depends on !LTO, and LTO would also drop Rust (rustc/clang LLVM differ).
# Don't sync filesystems on every suspend entry (LawRun); Android suspends
# many times an hour and data is already synced by normal writeback.
CONFIG_SUSPEND_SKIP_SYNC=y

# --- avr originals ---
CONFIG_LAUNCH_BOOST=y
CONFIG_AVR_PROFILE=y
CONFIG_RK_TBOOST=y
CONFIG_MQ_IOSCHED_ADIOS=y
# fq_codel as the default qdisc (Realking): bounded queueing delay under load
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y
